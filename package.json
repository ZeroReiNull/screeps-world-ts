{
  "name": "screeps-world-ts",
  "version": "1.0.0",
  "description": "My scripts for Screeps: World",
  "main": "index.js",
  "scripts": {
    "build": "tsc && node scripts/build.mjs",
    "deploy": "node --env-file=.env scripts/deploy.mjs",
    "watch": "node --env-file=.env scripts/watch.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "screeps"
  ],
  "author": "ZeroReiNull",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/screeps": "^3.4.0",
    "chokidar": "^5.0.0",
    "esbuild": "^0.28.2",
    "prettier": "3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "screeps-api": "^2.1.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
